#archive
archive

# Don't track training-cache audio (regenerated by daemon each run, ~300MB)
traning_data/_daily_auto/

# Re-include the agent_voiceprints folder (voiceprints, agents.json, reports,
# backups) — even though `data/` is ignored above, this folder is production
# state and must be committed.
!call_processor/data/agent_voiceprints/
!call_processor/data/agent_voiceprints/**

# Local-only candidate voiceprints from non-activated training runs
call_processor/data/agent_voiceprints/_candidates/
