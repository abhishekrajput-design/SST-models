      "display_speaker": "Zak Raissi Barnet",
      "agent_name": "Zak Raissi Barnet",
      "agent_slug": "zak_raissi_barnet"
    },
    {
      "start": 84.45,
      "end": 88.45,
      "text": "So you don't want no protection on your car?",
      "speaker": "SPEAKER_01",
      "identified_speaker": "AGENT",
      "display_speaker": "Zak Raissi Barnet",
      "agent_name": "Zak Raissi Barnet",
      "agent_slug": "zak_raissi_barnet"
    },
    {
      "start": 88.45,
      "end": 99.45,
      "text": "Uh, no it's fine, I have very bad experience with this kind of warranties, and we want to pay quicker the car, and yeah.",
